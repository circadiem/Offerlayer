# Offerlayer env
#
# DEMO MODE (local dev, pnpm demo*, pnpm test):
#   OFFERLAYER_DEMO=1 — the public seed keys below are used. The demo scripts
#   and test suite set this automatically; set it by hand for `pnpm api` /
#   `pnpm dev` if you want the demo keys.
#
# PRODUCTION (any reachable host):
#   Do NOT set OFFERLAYER_DEMO. The host refuses to boot unless every secret
#   below is set explicitly (generate with `openssl rand -hex 32`). The demo
#   seed keys are public and are rejected in production.

OFFERLAYER_DEMO=

PORT=8787
# Database. Forms:
#   postgres://…   real Postgres (required in production). On Supabase use the
#                  transaction pooler URL (port 6543). See docs/DATABASE.md.
#   pglite:<dir>   embedded Postgres saved to <dir> (demo mode only)
#   memory:        embedded Postgres in memory (demo mode only)
# Unset in demo mode = pglite:./data/pglite.
DATABASE_URL=
# Optional. Direct (port 5432) connection used only by `pnpm db:migrate`.
DATABASE_URL_DIRECT=
# Optional. Connections per serverless instance (default 5).
DB_POOL_MAX=

# REQUIRED in production. Three separate secrets, each 32+ characters and all
# different (the host refuses to boot otherwise). See docs/SECRETS.md for rotation.
# Signs checkout tokens (olt_...).
TOKEN_SIGNING_SECRET=
# Encrypts merchant Shopify access tokens at rest.
ACCESS_TOKEN_ENCRYPTION_KEY=
# HMAC key for shopper identifiers (principal_ref and order emails).
PRINCIPAL_HASH_SECRET=
# Rotation only: old values still accepted for verify/decrypt.
TOKEN_SIGNING_SECRET_PREVIOUS=
ACCESS_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# REQUIRED in production. Guards /v1/internal/* (including the cleanup job).
INTERNAL_API_KEY=
# Optional. Vercel Cron sends it as a bearer to /v1/internal/jobs/cleanup-discounts.
CRON_SECRET=

# Demo mode only: gates x-demo-key access. Ignored in production.
DEMO_KEY=

# Optional. PEM CA certificate for Postgres TLS when the provider's CA is not
# publicly trusted (e.g. Supabase). Certificates are always verified.
DATABASE_CA_CERT=

# Checkout limits (defaults shown). Per-key overrides live on the agents row.
# Token and discount-code lifetime, seconds.
CHECKOUT_TTL_SECONDS=1800
# Per agent key.
CHECKOUTS_PER_MINUTE=30
CHECKOUTS_PER_DAY=1000
# Checkouts with no principal_ref, per offer per UTC day.
ANON_CHECKOUTS_PER_OFFER_PER_DAY=50
# Unused, unexpired checkouts open at once on one offer.
MAX_OUTSTANDING_CHECKOUTS_PER_OFFER=200

SHOPIFY_API_KEY=
# REQUIRED in production when SHOPIFY_API_KEY is set (webhook HMAC).
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,read_orders,write_discounts

# Seeded agent keys (printed again by `pnpm seed`).
# REQUIRED in production — set all three to unique values per deploy.
# The values below are the PUBLIC demo keys; they only work with OFFERLAYER_DEMO=1.
DEMO_AGENT_KEY=agt_live_demo_v0_offerlayer_seed
MUSE_AGENT_KEY=agt_live_muse_v0_offerlayer_seed
SELLER_AGENT_KEY=agt_sell_demo_v0_offerlayer_seed
# MCP: set the key that matches the job. Never mix seller and shopper in one flow.
# OFFERLAYER_AGENT_KEY=agt_live_...
# OFFERLAYER_SELLER_KEY=agt_sell_...
