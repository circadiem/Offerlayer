# Offerlayer configuration. Every variable the server reads is listed here.
# Typed and validated in packages/db/src/env.ts (loadEnv).
#
# Demo mode (local dev, tests, `pnpm demo*`): set OFFERLAYER_DEMO=1 and leave
# the rest empty; public demo defaults fill in.
# Production: leave OFFERLAYER_DEMO empty. The host refuses to boot unless every
# REQUIRED value is set. Generate secrets with `openssl rand -hex 32`.

# --- Mode -------------------------------------------------------------------
# 1 = demo mode (public demo keys, simulate routes, demo data). Never in production.
OFFERLAYER_DEMO=

# --- Database (docs/DATABASE.md) --------------------------------------------
# REQUIRED in production: postgres:// URL (Supabase transaction pooler, port 6543,
# with ?sslmode=require). Demo mode: pglite:<dir>, memory:, or empty (= pglite:./data/pglite).
DATABASE_URL=
# Direct (port 5432) connection used only by `pnpm db:migrate`. Optional.
DATABASE_URL_DIRECT=
# PEM CA certificate for Postgres TLS, when Node doesn't trust the provider's CA. Optional.
DATABASE_CA_CERT=
# Connections per serverless instance. Default 5.
DB_POOL_MAX=
# Throwaway Postgres for running the test suite against real Postgres. Tests only.
TEST_DATABASE_URL=

# --- Secrets (docs/SECRETS.md) -----------------------------------------------
# REQUIRED. Signs checkout tokens. 32+ chars, unique.
TOKEN_SIGNING_SECRET=
# REQUIRED. Encrypts merchant Shopify access tokens. 32+ chars, unique.
ACCESS_TOKEN_ENCRYPTION_KEY=
# REQUIRED. HMAC key for shopper identifiers (principal_ref, order emails). 32+ chars, unique.
PRINCIPAL_HASH_SECRET=
# Rotation only: previous values still accepted for verify / decrypt.
TOKEN_SIGNING_SECRET_PREVIOUS=
ACCESS_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# REQUIRED. Operator access to /v1/internal/* (including jobs). 16+ chars.
INTERNAL_API_KEY=
# Bearer that Vercel Cron sends to /v1/internal/jobs/*. Optional, 16+ chars.
CRON_SECRET=

# --- Bootstrap agent keys (until self-serve keys ship) -----------------------
# REQUIRED. Shopper-agent key (agt_live_…), seeded as agent agt_shopper. 16+ chars.
SHOPPER_AGENT_KEY=
# REQUIRED. Seller-agent key (agt_sell_…), seeded as agent agt_seller. 16+ chars.
SELLER_AGENT_KEY=

# --- Demo mode only (ignored in production) ----------------------------------
# Gates the x-demo-key header. Defaults to a public demo value.
DEMO_KEY=
# Keys for the demo agents agt_demo and agt_muse. Default to public demo values.
DEMO_AGENT_KEY=
MUSE_AGENT_KEY=

# --- Shopify app (docs/SHOPIFY.md) --------------------------------------------
# Partner app client id. Empty = the install page stays a demo page.
SHOPIFY_API_KEY=
# REQUIRED when SHOPIFY_API_KEY is set. Partner app secret; also verifies webhooks.
SHOPIFY_API_SECRET=
# OAuth scopes requested at install.
SHOPIFY_SCOPES=read_products,read_orders,write_discounts

# --- Public URLs --------------------------------------------------------------
# Defaults: production www/api/mcp.offerlayer.io; demo mode 127.0.0.1. Override for staging.
# Marketing site and docs.
SITE_URL=
# Public API and webhook host. Used for install links, OAuth redirect, webhook URLs.
API_URL=
# Remote MCP server.
MCP_URL=
# Shopify app URL. Defaults to API_URL (which serves /auth/*).
SHOPIFY_APP_URL=

# --- Checkout limits (defaults shown) ---------------------------------------
# Token and discount-code lifetime, in seconds.
CHECKOUT_TTL_SECONDS=1800
# Per agent key. Per-key overrides live on the agents row.
CHECKOUTS_PER_MINUTE=30
CHECKOUTS_PER_DAY=1000
# Checkouts without a principal_ref, per offer per UTC day.
ANON_CHECKOUTS_PER_OFFER_PER_DAY=50
# Unused, unexpired checkouts open at once on one offer.
MAX_OUTSTANDING_CHECKOUTS_PER_OFFER=200

# --- Local processes --------------------------------------------------------
# Port for `pnpm api`. Default 8787. (PORT is also honored, for hosting platforms.)
OFFERLAYER_API_PORT=
# Used by `pnpm mcp` and `pnpm demo` when talking to a running API.
OFFERLAYER_URL=
OFFERLAYER_AGENT_KEY=
OFFERLAYER_SELLER_KEY=
