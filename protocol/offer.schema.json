{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offerlayer.dev/schema/offer-0.1.json",
  "title": "Offerlayer Offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "protocol",
    "merchant",
    "status",
    "selector",
    "reward",
    "constraints",
    "checkout",
    "disclosure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^off_[a-zA-Z0-9_]+$"
    },
    "protocol": {
      "const": "offerlayer/0.1"
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shop_domain", "name"],
      "properties": {
        "shop_domain": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "status": {
      "enum": ["draft", "live", "paused"]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["product", "collection", "shop"] },
        "ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "title": { "type": "string" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "list_price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "currency", "recipient"],
      "properties": {
        "type": { "enum": ["flat", "percent"] },
        "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "recipient": { "const": "buyer" }
      }
    },
    "finder_fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "currency", "recipient"],
      "properties": {
        "type": { "enum": ["flat", "percent"] },
        "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "recipient": { "const": "agent" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clawback_days"],
      "properties": {
        "new_customer_only": { "type": "boolean", "default": false },
        "ship_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 2 }
        },
        "max_per_principal_per_day": { "type": "integer", "minimum": 1 },
        "max_units_per_order": { "type": "integer", "minimum": 1 },
        "clawback_days": { "type": "integer", "minimum": 0, "maximum": 90 }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_url_template"],
      "properties": {
        "ucp": { "type": "boolean", "default": false },
        "tracked_url_template": {
          "type": "string",
          "description": "Use {token} placeholder for the offer token."
        }
      }
    },
    "disclosure": {
      "type": "string",
      "minLength": 16,
      "description": "Must be shown to the human before purchase approval."
    }
  }
}
