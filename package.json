{
  "name": "offerlayer",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm db:migrate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx packages/db/src/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:seller": "tsx scripts/demo-seller.ts",
    "demo:mandate": "tsx scripts/demo-mandate.ts",
    "demo:shopify": "tsx scripts/demo-shopify.ts",
    "demo:agentic": "tsx scripts/demo-agentic.ts",
    "api": "tsx apps/api/src/index.ts",
    "mcp": "tsx apps/mcp/src/stdio.ts",
    "shopify": "tsx apps/shopify/server.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "check:prod-boot": "tsx scripts/prod-boot-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^1.19.17",
    "@offerlayer/db": "workspace:*",
    "@offerlayer/schema": "workspace:*",
    "@offerlayer/token": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/history": "^1.162.4",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-core": "^1.171.32",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "lucide-react": "^0.510.0",
    "nanoid": "^5.1.16",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
